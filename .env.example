# Copy this file to .env.local and fill in your keys. .env.local is never committed.

# Required for `npm run enrich`. From themoviedb.org > Settings > API.
# Either the short "API Key" or the long "API Read Access Token" works.
TMDB_API_KEY=

# Optional. Turns on Theatre mode (watch-or-skip verdicts). Leave empty to hide it.
# Add it in Vercel too: Project > Settings > Environment Variables.
ANTHROPIC_API_KEY=
